# MongoDB Connection URL (MongoDB Atlas or local MongoDB)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="kgf"

# Allowed CORS origins
CORS_ORIGINS="*"

# JWT Secret for signing tokens
JWT_SECRET="change_this_to_a_random_secure_secret_key"

# Initial Admin Credentials (auto-seeded on first run)
ADMIN_EMAIL="admin@kgf.com"
ADMIN_PASSWORD="admin_123"
